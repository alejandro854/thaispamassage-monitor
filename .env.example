# Copia este archivo a .env para pruebas LOCALES (en GitHub van como Secrets).
# SMTP del correo desde el que se envían las alertas.
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_SECURE=false          # true si usas el puerto 465
SMTP_USER=alertas@dorica.agency
SMTP_PASS=xxxxxxxxxxxx
SMTP_FROM=alertas@dorica.agency
